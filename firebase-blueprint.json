{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Public and private user information",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "bio": { "type": "string" },
        "loyaltyPoints": { "type": "integer" },
        "createdAt": { "type": "number" }
      },
      "required": ["displayName", "loyaltyPoints", "createdAt"]
    },
    "Restaurant": {
      "title": "Restaurant",
      "description": "Details about a restaurant",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "cuisine": { "type": "array", "items": { "type": "string" } },
        "rating": { "type": "number" },
        "reviewCount": { "type": "integer" },
        "deliveryTimeMin": { "type": "integer" },
        "deliveryTimeMax": { "type": "integer" },
        "deliveryFee": { "type": "number" },
        "imageUrl": { "type": "string" },
        "categories": { "type": "array", "items": { "type": "string" } },
        "isPromoted": { "type": "boolean" }
      }
    },
    "MenuItem": {
      "title": "Menu Item",
      "description": "A dish offered by a restaurant",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "imageUrl": { "type": "string" },
        "category": { "type": "string" },
        "calories": { "type": "integer" },
        "isVegetarian": { "type": "boolean" }
      }
    },
    "Order": {
      "title": "Order",
      "description": "A food order",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "restaurantId": { "type": "string" },
        "restaurantName": { "type": "string" },
        "items": { "type": "array" },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "preparing", "delivering", "delivered", "cancelled"] },
        "createdAt": { "type": "number" },
        "estimatedDelivery": { "type": "number" },
        "deliveryAddress": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile data"
    },
    "/restaurants/{restaurantId}": {
      "schema": "Restaurant",
      "description": "Restaurant information"
    },
    "/restaurants/{restaurantId}/menu/{itemId}": {
      "schema": "MenuItem",
      "description": "Menu items for a restaurant"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Order records"
    }
  }
}
