rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 3. Primitives
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 2. Entity Validators
    function isValidUserProfile(data) {
      return data.displayName is string && data.displayName.size() <= 100 &&
             (data.bio == null || (data.bio is string && data.bio.size() <= 1000)) &&
             data.loyaltyPoints is int &&
             data.createdAt is number;
    }

    function isValidOrder(data) {
      return data.userId == request.auth.uid &&
             data.restaurantId is string &&
             data.items is list && data.items.size() > 0 &&
             data.total is number &&
             data.status in ['pending', 'confirmed', 'preparing', 'delivering', 'delivered', 'cancelled'] &&
             data.createdAt == request.time;
    }

    // 4. Match Blocks
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(incoming()) && incoming().loyaltyPoints == 0;
      allow update: if isOwner(userId) && isValidUserProfile(incoming()) &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'bio', 'photoURL']) &&
                    incoming().loyaltyPoints == existing().loyaltyPoints;
    }

    match /restaurants/{restaurantId} {
      allow get, list: if true;
      match /menu/{itemId} {
        allow get, list: if true;
      }
    }

    match /orders/{orderId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid);
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isValidOrder(incoming()) && isValidId(orderId);
      allow update: if isSignedIn() && isOwner(existing().userId) && 
                    existing().status != 'delivered' &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['status']) &&
                    incoming().status in ['cancelled'];
    }
  }
}
